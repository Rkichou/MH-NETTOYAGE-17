rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function text(data, field, maximum) {
      return data[field] is string && data[field].size() > 0 && data[field].size() <= maximum;
    }
    function optionalText(data, field, maximum) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maximum);
    }
    match /reservations/{reservationId} {
      allow create: if request.resource.data.keys().hasOnly([
          "name",
          "phone",
          "email",
          "service",
          "date",
          "time",
          "address",
          "message",
          "status",
          "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "name",
          "phone",
          "service",
          "date",
          "time",
          "status",
          "createdAt"
        ])
        && text(request.resource.data, "name", 80)
        && text(request.resource.data, "phone", 20)
        && request.resource.data.phone.matches('.*[0-9].*')
        && text(request.resource.data, "service", 120)
        && text(request.resource.data, "date", 10)
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && text(request.resource.data, "time", 80)
        && optionalText(request.resource.data, "email", 120)
        && (!("email" in request.resource.data) || request.resource.data.email == null || request.resource.data.email.matches('[^ @]+@[^ @]+[.][^ @]+'))
        && optionalText(request.resource.data, "address", 500)
        && optionalText(request.resource.data, "message", 1000)
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;

      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
